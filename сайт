<style>
:root{
  --bg:#15112A; --surface:#1F1A3A; --line:#2F2852;
  --text:#F1EEF8; --muted:#B1AAC8;
  --accent:#B7A3F2; --accent-hover:#C8B8F7;
  --s1:8px; --s2:16px; --s3:24px; --s4:32px; --s6:48px; --s8:64px; --s12:96px;
  --r:4px;
  --font:'Onest',system-ui,-apple-system,'Segoe UI',Roboto,Arial,sans-serif;
}
*,*::before,*::after{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
@media (prefers-reduced-motion:no-preference){html{scroll-behavior:smooth}}
body{margin:0;background:var(--bg);color:var(--text);font:400 17px/1.5 var(--font);-webkit-font-smoothing:antialiased}
svg{display:block;max-width:100%}
a{color:inherit}
h1,h2,h3,p,dl,dd{margin:0}
h1,h2,h3{font-weight:800;line-height:1.1;letter-spacing:-.01em}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.wrap{max-width:1120px;margin:0 auto;padding:0 var(--s3)}
.ico{width:20px;height:20px;stroke:currentColor;fill:none;stroke-width:1.75;stroke-linecap:round;stroke-linejoin:round;flex:none}

/* Кнопки */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--s1);min-height:56px;padding:0 var(--s4);border:2px solid var(--accent);border-radius:var(--r);background:var(--accent);color:var(--bg);font:700 17px/1 var(--font);text-decoration:none;cursor:pointer}
.btn:hover{background:var(--accent-hover);border-color:var(--accent-hover)}
.btn.ghost{background:transparent;color:var(--text)}
.btn.ghost:hover{background:var(--surface);border-color:var(--accent)}

/* Шапка */
.top{border-bottom:1px solid var(--line)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;min-height:72px}
.brand{font-weight:800;font-size:24px;text-decoration:none;letter-spacing:-.02em}
.nav{display:none;gap:var(--s4)}
.nav a{font-size:15px;color:var(--muted);text-decoration:none}
.nav a:hover{color:var(--text)}
.call{display:inline-flex;align-items:center;justify-content:center;gap:var(--s1);min-width:48px;min-height:48px;text-decoration:none;font-weight:500;font-size:15px}
.call span{display:none}

/* Первый экран */
.hero{padding:var(--s8) 0 var(--s6)}
.hero-photo{margin:0 0 var(--s4);border-radius:var(--r);overflow:hidden;background:var(--surface)}
.hero-photo img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:cover}
@media (min-width:768px){.hero-photo img{aspect-ratio:21/9;object-position:center 40%}}
.hero h1{font-size:56px;letter-spacing:-.03em}
.hero .lead{margin-top:var(--s2);font-size:20px;max-width:24ch}
.hero .addr{margin-top:var(--s2);font-size:13px;color:var(--muted);line-height:1.6}
.hero .actions{margin-top:var(--s4);display:grid;gap:var(--s2);max-width:360px}
.stats{list-style:none;margin:var(--s6) 0 0;padding:var(--s3) 0 0;border-top:1px solid var(--line);display:grid;grid-template-columns:1fr 1fr;gap:var(--s3)}
.stats strong{display:block;font-size:28px;font-weight:800;line-height:1.1}
.stats span{display:block;margin-top:4px;font-size:13px;color:var(--muted)}

/* Лента фото */
.strip{display:flex;gap:var(--s1);overflow-x:auto;scroll-snap-type:x mandatory;padding:0 var(--s3) var(--s1);scrollbar-width:thin}
.strip .ph{flex:0 0 240px;scroll-snap-align:start}
.ph{aspect-ratio:4/3;border-radius:var(--r);background:var(--surface);display:flex;align-items:flex-end;padding:var(--s2);font-size:13px;color:var(--muted)}
.ph:nth-child(2n){background:#241E44}

.shot{flex:0 0 280px;scroll-snap-align:start}
.shot img{display:block;width:100%;height:auto;aspect-ratio:4/3;object-fit:cover;border-radius:var(--r);background:var(--surface)}

/* Секции */
section{padding:var(--s8) 0}
h2{font-size:28px}
.sec-sub{margin-top:var(--s2);color:var(--muted);max-width:52ch}
.alt{background:var(--surface)}

/* Зоны */
.zones{margin-top:var(--s4);display:grid;gap:var(--s3)}
.zone{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:var(--s3)}
.alt .zone{background:var(--bg)}
.zone h3{font-size:28px}
.zone .for{margin-top:var(--s1);color:var(--muted);font-size:15px}
.spec{margin-top:var(--s3)}
.spec div{display:flex;justify-content:space-between;gap:var(--s2);padding:var(--s2) 0;border-top:1px solid var(--line);font-size:15px}
.spec dt{color:var(--muted);flex:none}
.spec dd{text-align:right;font-weight:500}

/* Тарифы */
.tariffs{margin-top:var(--s4);display:grid;gap:var(--s3)}
.tariff{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:var(--s3)}
.tariff h3{font-size:20px}
.tariff table{width:100%;margin-top:var(--s2);border-collapse:collapse;font-size:15px}
.tariff th,.tariff td{padding:var(--s2) 0;text-align:right;border-top:1px solid var(--line);font-weight:500;white-space:nowrap}
.tariff th:first-child,.tariff td:first-child{text-align:left;white-space:normal;padding-right:var(--s1)}
.tariff thead th{font-size:13px;color:var(--muted);border-top:0;padding-top:0}
.tariff tbody td:not(:first-child){font-weight:800}
.tariff tbody th{font-weight:500;text-align:left}
.cta{margin-top:var(--s4)}

/* Отзывы */
.demo-note{margin-top:var(--s2);font-size:15px;color:var(--accent)}
.reviews{margin-top:var(--s4);display:grid;gap:var(--s2)}
.review{background:var(--surface);border:1px solid var(--line);border-radius:var(--r);padding:var(--s3)}
.review header{display:flex;justify-content:space-between;align-items:center;gap:var(--s2);margin-bottom:var(--s2)}
.review b{font-weight:700}
.tag{font-size:13px;padding:4px var(--s1);border:1px solid var(--accent);border-radius:var(--r);color:var(--accent)}
.review p{color:var(--muted);font-size:15px;line-height:1.6}

/* Как добраться */
.where dl{margin-top:var(--s4);display:grid;gap:var(--s3)}
.where dt{font-size:13px;color:var(--muted)}
.where dd{margin-top:4px}
.map-box{border-radius:var(--r);overflow:hidden;background:var(--bg);border:1px solid var(--line)}
.map-box iframe{display:block;border:0;width:100%;height:320px}
@media (min-width:768px){.map-box iframe{height:400px}}
.btns{display:flex;flex-wrap:wrap;gap:var(--s2);margin-top:var(--s3)}
.where .btn{margin-top:0}

/* Подвал */
footer{border-top:1px solid var(--line);padding:var(--s6) 0 var(--s4);font-size:15px;color:var(--muted)}
footer .cols{display:grid;gap:var(--s4)}
footer .big{display:block;color:var(--text);font-size:28px;font-weight:800;text-decoration:none}
footer ul{list-style:none;margin:0;padding:0;display:grid;gap:var(--s1)}
footer a{text-decoration:none}
footer a:hover{color:var(--text)}
footer .legal{margin-top:var(--s6);display:flex;flex-direction:column;gap:var(--s1);font-size:13px}

/* Появление при прокрутке: снизу вверх */
.js [data-reveal]{opacity:0;transform:translateY(24px);transition:opacity .6s ease,transform .6s ease;transition-delay:var(--d,0ms)}
.js [data-reveal].in{opacity:1;transform:none}
.js .spec .ico{opacity:0;transform:translateY(16px);transition:opacity .5s ease .15s,transform .5s ease .15s}
.js .spec .in .ico{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  .js [data-reveal],.js .spec .ico{opacity:1;transform:none;transition:none}
}
.spec dt{display:flex;align-items:center;gap:var(--s1)}
.spec .ico{color:var(--accent)}

/* Планшет и десктоп */
@media (min-width:768px){
  .nav{display:flex}
  .call span{display:inline}
  .hero{padding:var(--s12) 0 var(--s8)}
  .hero .actions{grid-template-columns:1fr 1fr;max-width:560px}
  .stats{grid-template-columns:repeat(4,1fr)}
  .strip{display:grid;grid-template-columns:repeat(3,1fr);overflow:visible;max-width:1120px;margin:0 auto}
  .shot{flex:none}
  section{padding:var(--s12) 0}
  .zones,.tariffs{grid-template-columns:1fr 1fr}
  .reviews{grid-template-columns:repeat(3,1fr);gap:var(--s3)}
  .where .cols2{display:grid;grid-template-columns:1fr 1fr;gap:var(--s8);align-items:start}
  .where dl{margin-top:0}
  footer .cols{grid-template-columns:2fr 1fr 1fr}
  footer .legal{flex-direction:row;justify-content:space-between}
}
@media (min-width:1024px){
  .hero h1{font-size:56px}
  h2{font-size:40px}
}
@media (max-width:767px){
  .hero h1{font-size:40px}
}
</style>
