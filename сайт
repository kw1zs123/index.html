  document.querySelectorAll('[data-route]').forEach(function(a){
    a.href='https://yandex.ru/maps/?rtext=~'+CLUB.lat+'%2C'+CLUB.lng+'&rtt=auto';
  });
  var map=document.getElementById('map');
  if(map){
    var ll=CLUB.lng+'%2C'+CLUB.lat;
    map.src='https://yandex.ru/map-widget/v1/?ll='+ll+'&z=16&pt='+ll+'%2Cpm2rdl';
  }
})();
</script>
